{
  "name": "kalpana",
  "version": "1.0.1",
  "description": "Make ad creatives and social posts from a brief, then generate them in bulk from your data, from Gemini CLI.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "kalpana-batch": {
      "httpUrl": "https://mcp.kalpana.one/mcp/batch",
      "oauth": {
        "enabled": true
      },
      "timeout": 30000
    },
    "kalpana-designer": {
      "httpUrl": "https://mcp.kalpana.one/mcp/designer",
      "oauth": {
        "enabled": true
      },
      "timeout": 60000
    }
  }
}
